  {
    "name": "unlock_records",
    "description": "SPENDS CREDITS: one per agent, two per brokerage. Obtain the user's approval for the exact selection and maxCredits before calling. Reuse the SAME UUID idempotencyKey and parameters on retries; never automatically create a new key after a timeout. Already-owned and contactless records cost zero.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agents",
            "brokerages"
          ]
        },
        "releaseId": {
          "type": "string"
        },
        "ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "maxItems": 100
        },
        "filters": {
          "type": "object"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maxCredits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "idempotencyKey": {
          "type": "string",
          "format": "uuid"
        },
        "confirmCreditSpend": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "kind",
        "releaseId",
        "maxCredits",
        "idempotencyKey",
        "confirmCreditSpend"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create_export",
    "description": "Prepare an authenticated CSV download request for owned records. The download applies your suppression list and records an export audit. No credits spent; do not include your API key in a URL.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agents",
            "brokerages"
          ]
        },
        "template": {
          "type": "string",
          "enum": [
            "standard",
            "hubspot",
            "salesforce",
            "follow_up_boss",
            "apollo",
            "instantly"
          ]
        },
        "list": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
