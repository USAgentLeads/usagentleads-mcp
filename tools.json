  {
    "name": "owned_records",
    "description": "Read previously unlocked records. No record credits spent. Returns at most 100 records per page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agents",
            "brokerages"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "enum": [
            25,
            50,
            100
          ]
        },
        "list": {
          "type": "string",
          "format": "uuid"
        },
        "q": {
          "type": "string",
          "maxLength": 60
        }
      },
      "additionalProperties": false
    },
